# Environment Variables for Rose Water Scraper

# User-Agent header for HTTP requests
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"

# Logging configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"

# Default output directory
OUTPUT_DIR="output"

# Default maximum pages to scrape per site
MAX_PAGES=40

# Webshare Proxy Configuration
USE_PROXIES=false
WEBSHARE_USERNAME="your_webshare_username"
WEBSHARE_PASSWORD="your_webshare_password"
WEBSHARE_GATEWAY="p.webshare.io"
WEBSHARE_PORT=80
WEBSHARE_MODE="rotating"  # Options: 'rotating' (uses username-rotate) or 'direct'
